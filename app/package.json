{
  "name": "@shopflow/app",
  "private": true,
  "version": "0.9.0",
  "description": "ShopFlow - the running example from Architecting at Scale. Current state: end of Chapter 9 (caching).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --dry && tsc -p packages/cache/tsconfig.json --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "catalog": "npm run -w @shopflow/catalog dev"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  }
}
