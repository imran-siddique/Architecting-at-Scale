{
  "name": "@shopflow/app",
  "private": true,
  "version": "0.9.0",
  "description": "ShopFlow - the running example from Architecting at Scale, evolving across the book.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "monolith": "npm run -w @shopflow/monolith dev"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
