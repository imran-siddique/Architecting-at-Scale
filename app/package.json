{
  "name": "@shopflow/app",
  "private": true,
  "version": "0.9.0",
  "description": "ShopFlow - the running example from Architecting at Scale, evolving across the book.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "monolith": "npm run -w @shopflow/monolith dev",
    "test:all": "REDIS_URL=redis://127.0.0.1:6379 vitest run",
    "verify": "npm ci && tsc --build && vitest run"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
